PORT=3000

# Banco de dados (Postgres)
DATABASE_URL=

# Autenticação do admin (use um texto longo e aleatório)
JWT_SECRET=

# Origens liberadas no CORS, separadas por vírgula (painel e app)
# Ex.: http://localhost:5173,http://localhost:5174
FRONTEND_URLS=

# Cloudinary (upload dos PDFs)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin criado pelo seed (npm run seed)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
